<section id="contact" class="py-24 bg-slate-50">
  <div class="max-w-4xl mx-auto px-6">
    <div class="max-w-2xl">
      <h2 class="text-xs font-semibold text-teal tracking-widest uppercase mb-8">Contact</h2>
      <p class="text-2xl font-semibold text-slate-900 leading-snug mb-4">
        If you're building or scaling a technical support engineering function,
        I'd enjoy the conversation.
      </p>
      <p class="text-slate-500 mb-10">
        Also happy to talk developer tooling, team building, or the weird overlap between
        engineering and customer empathy.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="mailto:enrique@enriquegh.com"
          class="inline-flex items-center gap-2 px-6 py-3 bg-teal text-white font-medium rounded-lg hover:bg-teal-dark transition-colors"
        >
          enrique@enriquegh.com
        </a>
        <a
          href="https://linkedin.com/in/egonzalezh94"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 border border-slate-200 text-slate-700 font-medium rounded-lg hover:border-teal hover:text-teal transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          class="inline-flex items-center gap-2 px-6 py-3 border border-slate-200 text-slate-700 font-medium rounded-lg hover:border-teal hover:text-teal transition-colors"
        >
          Resume
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="py-8 border-t border-slate-100">
  <div class="max-w-4xl mx-auto px-6 flex items-center justify-between">
    <p class="text-sm text-slate-400">© {new Date().getFullYear()} Enrique Gonzalez</p>
    <div class="flex items-center gap-5">
      <a
        href="https://github.com/enriquegh"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-slate-400 hover:text-teal transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/egonzalezh94"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-slate-400 hover:text-teal transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
